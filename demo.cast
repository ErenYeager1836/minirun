[0.011393, "o", "\u001b[1mminirun - Linux Container Runtime & eBPF Active Defense\u001b[0m\r\nDemonstration: Namespaces, Cgroups v2, Seccomp-BPF & Guard\r\n\r\n"]
[1.013233, "o", "\r\n\u001b[1m\u001b[0;36m==> 1. Checking host kernel prerequisites with 'minirun doctor'...\u001b[0m\r\n"]
[2.21698, "o", "=== minirun Linux Environment Diagnostics ===\r\n  [✓] Kernel: Linux version 7.2.11-arch1-1 (linux@archlinux) (gcc (GCC) 16.2.1 20260810, GNU ld (GNU Binutils) 2.47) #1 SMP PREEMPT_DYNAMIC Fri, 16 Oct 2026 00:28:58 +0000\r\n"]
[2.217007, "o", "  [✓] Cgroups v2: Active (Available controllers: cpuset cpu io memory hugetlb pids rdma misc dmem)\r\n  [✓] Unprivileged User Namespaces: Enabled (Rootless supported)\r\n"]
