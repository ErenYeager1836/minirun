[12.59288, "o", "\u001b[2m2026-11-21T10:12:51.675447Z\u001b[0m \u001b[32m INFO\u001b[0m \u001b[2mminirun::container\u001b[0m\u001b[2m:\u001b[0m Executing as PID 1: /bin/sh [\"-c\", \"python3 -c \\\"import socket, threading, time, os; t=threading.Thread(target=lambda: (lambda s: (s.bind((\\\\\\\"127.0.0.1\\\\\\\", 19876)), s.listen(1), s.accept()))(socket.socket(socket.AF_INET, socket.SOCK_STREAM))); t.daemon=True; t.start(); time.sleep(0.15); s=socket.socket(); s.connect((\\\\\\\"127.0.0.1\\\\\\\", 19876)); os.dup2(s.fileno(), 0); os.dup2(s.fileno(), 1); os.system(\\\\\\\"/bin/sh -c exit\\\\\\\")\\\"\"]\r\n"]
